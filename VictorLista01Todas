import java.util.Scanner;


public class Exemplo2 {
   public static void main(String[] args) {
       int numeroUm;
       int numeroDois;
       int resultado;
       // Scanner permite realizar a leitura de dados
       // de uma fonte específica
       Scanner entrada = new Scanner(System.in);


       System.out.println(".| Programa para somar " +
               "dois números inteiros |.\n");


       System.out.print("Informe o " +
               "primeiro número: ");


       numeroUm = entrada.nextInt();


       System.out.print("Informe o " +
               "segundo número: ");


       numeroDois = entrada.nextInt();


       resultado = numeroDois + numeroUm;


       System.out.println();
       // O símbolo de adição é usado para fazer a contatenção dos dados
       System.out.println("O resultado da soma é: " + resultado);
       // Outra maneira de fazer a concatenação do conteúdos
       System.out.printf("%d + %d = %d\n", numeroUm, numeroDois, resultado);
   }
}













