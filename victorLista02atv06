import java.util.Scanner;

public class exercicio06 {
    public static void main(String[] args) {
        Scanner leitor = new Scanner(System.in);

        // 1. Entrada de dados
        System.out.print("Digite o código do produto (de 1 a 40): ");
        int codigo = leitor.nextInt();

        System.out.print("Digite a quantidade comprada: ");
        int quantidade = leitor.nextInt();

        // 2. Descobrir o preço unitário (Tabela I)
        double precoUnitario = 0;

        if (codigo >= 1 && codigo <= 10) {
            precoUnitario = 10.0;
        } else if (codigo >= 11 && codigo <= 20) {
            precoUnitario = 15.0;
        } else if (codigo >= 21 && codigo <= 30) {
            precoUnitario = 20.0;
        } else if (codigo >= 31 && codigo <= 40) {
            precoUnitario = 30.0;
        }

        // Calcula o valor total sem desconto
        double precoTotal = precoUnitario * quantidade;

        // 3. Descobrir o valor do desconto (Tabela II)
        double desconto = 0;

        if (precoTotal <= 250) {
            desconto = precoTotal * 0.05; // 5% de desconto
        } else if (precoTotal <= 500) {
            desconto = precoTotal * 0.10; // 10% de desconto
        } else {
            desconto = precoTotal * 0.15; // 15% de desconto
        }

        // Calcula o valor final com o abatimento
        double precoFinal = precoTotal - desconto;

        // 4. Mostrar os resultados na tela
        System.out.println("Preço unitário: R$ " + precoUnitario);
        System.out.println("Preço total da nota: R$ " + precoTotal);
        System.out.println("Valor do desconto: R$ " + desconto);
        System.out.println("Preço final a pagar: R$ " + precoFinal);

        leitor.close();
    }
}
